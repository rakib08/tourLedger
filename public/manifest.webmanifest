{
  "id": "/dashboard",
  "name": "TourLedger — Group Trip Accounts",
  "short_name": "TourLedger",
  "description": "Transparent tour group contributions and expense tracking.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f5f7fa",
  "theme_color": "#10243a",
  "orientation": "portrait-primary",
  "categories": ["finance", "travel", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
